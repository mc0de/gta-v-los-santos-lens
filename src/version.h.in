#pragma once
// Generated by CMake from version.h.in. LSL_VERSION_STR is "X.Y.Z" for releases, "dev" for local builds.
#define LSL_VERSION_STR "@LSL_VERSION@"
#define LSL_VERSION_MAJOR @LSL_VERSION_MAJOR@
#define LSL_VERSION_MINOR @LSL_VERSION_MINOR@
#define LSL_VERSION_PATCH @LSL_VERSION_PATCH@
#define LSL_IS_RELEASE (LSL_VERSION_MAJOR + LSL_VERSION_MINOR + LSL_VERSION_PATCH > 0)
