// File version shown in the .asi's Properties -> Details.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LSL_VERSION_MAJOR, LSL_VERSION_MINOR, LSL_VERSION_PATCH, 0
PRODUCTVERSION LSL_VERSION_MAJOR, LSL_VERSION_MINOR, LSL_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Los Santos Lens"
            VALUE "ProductName", "Los Santos Lens"
            VALUE "FileVersion", LSL_VERSION_STR
            VALUE "ProductVersion", LSL_VERSION_STR
            VALUE "OriginalFilename", "LosSantosLens.asi"
            VALUE "InternalName", "LosSantosLens"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
